<div class="container mx-auto p-6">
  <h1 class="text-4xl font-bold text-gray-800 mb-2">
    <%= @tournament.name %>
    <%= link_to "✏️", edit_tournament_path(@tournament) if authenticated? %>
  </h1>

  <p class="text-lg text-gray-600 mb-6">
    <% if @tournament.date_start == @tournament.date_end %>
      <%= @tournament.date_start.andand.strftime("%d.%m.%Y") %>
    <% else %>
      <%= @tournament.date_start.andand.strftime("%d.%m.%Y") %>
      -
      <%= @tournament.date_end.andand.strftime("%d.%m.%Y") %>
    <% end %>
  </p>

  <p class="text-lg text-gray-600 mb-6">
  <%= t ".Place" %>: <%= @tournament.place %>
  </p>

  <div class="text-lg text-gray-600 mb-6">
    <%= t ".Current number of participants" %>: <%= @tournament.participants.count %>
    <% @tournament.groups.each do |g| %>
      <div>
        <%= g.name %>: <%= g.participants.count.to_s %>
      </div>
    <% end %>
  </div>

  <div class="prose prose-a:text-blue-600 prose-a:hover:text-blue-700 mb-6">
    <%= @tournament.description %>
  </div>

  <p class="mb-6">
    <%= link_to (t ".Go to registration"), tournament_participants_path(@tournament), class: "inline-block px-4 py-2 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
  </p>

  <% if authenticated? %>
    <%= link_to (t ".Manage Groups"), tournament_groups_path(@tournament), class: "mt-2 rounded-md px-3.5 py-2.5 text-white bg-blue-600 hover:bg-blue-500 font-medium" %>

    <section class="mt-8 border-t border-gray-200 pt-6">
      <h2 class="text-2xl font-bold text-gray-800 mb-2"><%= t ".Export tournament" %></h2>
      <p class="text-gray-600 mb-4"><%= t ".Export description" %></p>
      <%= form_with url: export_tournament_path(@tournament), method: :get, data: { turbo: false } do |form| %>
        <div class="flex items-center gap-2 mb-4">
          <%= form.check_box :include_participants %>
          <%= form.label :include_participants, t(".Include participants") %>
        </div>
        <%= form.submit t(".Download as JSON"), class: "rounded-md px-3.5 py-2.5 bg-gray-600 hover:bg-gray-500 text-white font-medium cursor-pointer" %>
      <% end %>
    </section>
  <% end %>

</div>
